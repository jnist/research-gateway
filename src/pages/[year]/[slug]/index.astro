---
import { getCollection } from 'astro:content';
import { href } from '../../../lib/site';
export async function getStaticPaths() {
  return (await getCollection('research')).map(entry => ({
    params: { year: String(entry.data.year), slug: entry.id },
    props: { slug: entry.id },
  }));
}
const destination = href(`dataset/${Astro.props.slug}/`);
const canonical = Astro.site ? new URL(destination, Astro.site).href : destination;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Page moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination + window.location.search + window.location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${destination}`} /></noscript>
  </head>
  <body><a href={destination}>Continue to the dataset</a></body>
</html>
