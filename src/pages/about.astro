---
import { ArrowUpRight, Mail } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { href, institution } from '../lib/site';
import T from '../components/T.astro';
import { attrs } from '../lib/i18n.js';
---
<SiteLayout title="关于研究院" titleEn="About JNIST" active="about">
  <section class="section container">
    <p class="eyebrow">ABOUT JNIST</p><h1><T zh={institution.name} en={institution.english}/></h1><p class="muted" lang="en" data-locale="zh">{institution.english}</p>
    <img class="campus" src={href('images/jnist-campus.webp')} {...attrs('alt', '国家超级计算济南中心园区与建筑', 'Campus and buildings of the National Supercomputing Center in Jinan')} width="1903" height="795" />
    <div class="about-grid">
      <div class="prose"><h2><T zh="研究院简介" en="Institute profile"/></h2><p><T zh="济南超级计算技术研究院是在济南市人民政府指导下，由山东省科学院和济南市历城区人民政府共同举办的新型研发机构，聚焦超算关键技术与创新应用。" en="The Jinan Institute of Supercomputing Technology is a research and development institution jointly established by the Shandong Academy of Sciences and the Licheng District Government, under the guidance of the Jinan Municipal Government. Its work focuses on core supercomputing technologies and innovative applications."/></p><a href={institution.website} class="text-link" target="_blank" rel="noopener noreferrer"><T zh="访问研究院官网" en="Visit the institute website"/> <ArrowUpRight size={16}/></a></div>
      <aside><h2><T zh="联系与交流" en="Contact"/></h2><a class="text-link" href="mailto:contact@jnist.cn"><Mail size={17}/>contact@jnist.cn</a><p><T zh="中国（山东）自由贸易试验区" en="No. 28666, Jingshi East Road"/><br/><T zh="济南片区经十东路 28666 号" en="Jinan Area, China (Shandong) Pilot Free Trade Zone"/></p><a class="text-link" href={institution.repository} target="_blank" rel="noopener noreferrer"><T zh="门户代码与问题反馈" en="Source code and issues"/> <ArrowUpRight size={16}/></a></aside>
    </div>
  </section>
</SiteLayout>
<style>
  .campus { width: 100%; height: auto; margin-block: 34px 42px; }
  .about-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 70px; }
  aside { border-left: 1px solid var(--color-border); padding-left: 30px; }
  aside h2 { font-size: 22px; }
  aside p { font-size: 13px; color: var(--color-muted); margin-top: 20px; }
  @media (max-width: 700px) { .about-grid { grid-template-columns: 1fr; gap: 30px; } aside { padding-left: 0; border-left: 0; } }
</style>
