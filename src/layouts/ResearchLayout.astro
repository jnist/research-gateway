---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight, ArrowUpRight, ChevronRight, Download, FileArchive, FileText, Database } from '@lucide/astro';
import SiteLayout from './SiteLayout.astro';
import Citation from '../components/Citation.astro';
import { href } from '../lib/site';
import T from '../components/T.astro';
import { attrs } from '../lib/i18n.js';
interface Props { entry: CollectionEntry<'research'>; }
const { entry } = Astro.props;
const data = entry.data;
const fullDatasetPath = data.datasetArchivePath || data.datasetPath;
---
<SiteLayout title={data.title} titleEn={data.englishTitle} description={data.summary} descriptionEn={data.en.summary}>
  <section class="research-intro">
    <div class="container">
      <nav class="breadcrumb" {...attrs('aria-label', '面包屑', 'Breadcrumb')}><a href={href('/')}><T zh="科研成果" en="Research"/></a><ChevronRight size={13}/><span><T zh={data.title} en={data.englishTitle}/></span></nav>
      <div class="tags"><span class="tag tag-green"><T zh={data.status} en={data.en.status}/></span><span class="tag tag-neutral">v{data.version}</span>{data.tags.map((tag, index) => <span class="tag tag-neutral"><T zh={tag} en={data.en.tags[index]}/></span>)}</div>
      <h1><T zh={data.title} en={data.englishTitle}/></h1><p class="research-english" lang="en" data-locale="zh">{data.englishTitle}</p><p class="summary"><T zh={data.summary} en={data.en.summary}/></p>
      {data.authors.length > 0 && <p class="muted">{data.authors.join(' · ')}</p>}
      <div class="actions">
        {data.tool && <a class="button button-primary" href="#explorer"><T zh="在线使用" en="Open explorer"/> <ArrowRight size={16}/></a>}
        {fullDatasetPath && <a class="button" href={href(fullDatasetPath)} download><Download size={16}/><T zh="完整数据" en="Full dataset"/></a>}
        {data.paperUrl && <a class="button" href={data.paperUrl} target="_blank" rel="noopener noreferrer"><FileText size={16}/><T zh="论文" en="Paper"/> <ArrowUpRight size={14}/></a>}
        {data.codeUrl && <a class="text-link" href={data.codeUrl} target="_blank" rel="noopener noreferrer"><T zh="成果代码" en="Research code"/> <ArrowUpRight size={16}/></a>}
      </div>
    </div>
  </section>
  <nav class="research-tabs" {...attrs('aria-label', '成果页内导航', 'Research sections')}><div class="container">
    <a href="#overview"><T zh="成果概述" en="Overview"/></a>{data.tool && <a href="#explorer"><T zh="在线工具" en="Explorer"/></a>}{data.datasetPath && <a href="#downloads"><T zh="数据下载" en="Downloads"/></a>}<a href="#citation"><T zh="引用与版本" en="Citation"/></a>
  </div></nav>
  <slot name="explorer"/>
  <section id="overview" class="section"><div class="container">
    <div class="section-heading"><h2><span class="section-number">02</span><T zh="成果概述与数据说明" en="Overview and data documentation"/></h2></div>
    <div class="prose"><slot /></div>
  </div></section>
  {data.datasetPath && <section id="downloads" class="section section-tint"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">DATA & RESOURCES</p><h2><span class="section-number">03</span><T zh="数据下载" en="Downloads"/></h2></div><span class="tag tag-green">v{data.version}</span></div>
    {data.datasetArchivePath && <div class="download-row"><FileArchive size={27}/><div><h3><T zh="完整数据集打包下载" en="Complete dataset archive"/></h3><p><T zh="ZIP · CSV 数据、晶体结构、索引与版本信息" en="ZIP · CSV data, crystal structures, indexes and release information"/></p></div><a class="button" href={href(data.datasetArchivePath)} download><Download size={16}/><T zh="下载 ZIP" en="Download ZIP"/></a></div>}
    <div class="download-row"><Database size={27}/><div><h3><T zh="数据清单下载" en="Dataset listing"/></h3><p><T zh="原始 CSV · 标准化化学式、晶体原型与文献 DOI" en="Original CSV · Standardized formulas, crystal prototypes and source DOIs"/></p></div><a class="button" href={href(data.datasetPath)} download><Download size={16}/><T zh="下载 CSV" en="Download CSV"/></a></div>
    <p class="license-note"><T zh={data.licenseNote} en={data.en.licenseNote}/></p>
  </div></section>}
  <section id="citation" class="section"><div class="container">
    <div class="section-heading"><h2><span class="section-number">04</span><T zh="引用与版本" en="Citation and version"/></h2></div>
    <Citation citation={data.citation} bibtex={data.bibtex}/>
  </div></section>
</SiteLayout>
<script>
  const nav = document.querySelector<HTMLElement>('.research-tabs');
  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    // The explorer precedes the overview in the document, unlike the menu order.
    const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'))
      .filter(section => links.some(link => link.hash === `#${section.id}`));
    let pending = false;

    const updateActiveSection = () => {
      pending = false;
      const root = document.documentElement;
      const offset = Math.max(nav.offsetHeight, parseFloat(getComputedStyle(root).scrollPaddingTop) || 0);
      let active: HTMLElement | undefined = sections[0];
      for (const section of sections) {
        const margin = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;
        // Allow a small preceding-section tail above the main reading area.
        const activationLine = Math.max(offset + margin + 1, window.innerHeight * 0.25);
        if (section.getBoundingClientRect().top <= activationLine) active = section;
      }
      // Short final sections may never reach the activation line.
      if (window.scrollY > 0 && Math.ceil(window.scrollY + window.innerHeight) >= root.scrollHeight - 1) {
        active = sections.at(-1);
      }
      for (const link of links) {
        if (active && link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const scheduleUpdate = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(updateActiveSection);
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);
    const observer = new ResizeObserver(scheduleUpdate);
    observer.observe(nav);
    for (const section of sections) observer.observe(section);
    updateActiveSection();
  }
</script>
<style>
  .research-intro { padding-block: 26px 36px; background: #f6f8fb; }
  .breadcrumb { display: flex; align-items: center; gap: 9px; font-size: 12px; color: var(--color-muted); margin-bottom: 27px; }
  h1 { margin: 18px 0 8px; font-size: 34px; }
  .research-english { font-size: 16px; color: #536580; margin-bottom: 15px; }
  .summary { max-width: 810px; font-size: 14px; color: var(--color-muted); margin-bottom: 24px; }
  .research-tabs { background: white; border-block: 1px solid var(--color-border); position: sticky; top: 0; z-index: 10; }
  .research-tabs > div { display: flex; gap: 36px; }
  .research-tabs a { font-size: 14px; padding-block: 15px; white-space: nowrap; border-bottom: 2px solid transparent; }
  .research-tabs a[aria-current="location"] { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .download-row { display: flex; align-items: center; gap: 22px; padding: 23px 0; border-top: 1px solid var(--color-border); }
  .download-row > svg { color: var(--color-primary); }
  .download-row > div { flex: 1; }
  .download-row h3 { font-size: 17px; margin: 0 0 5px; }
  .download-row p { font-size: 12px; color: var(--color-muted); margin: 0; }
  .license-note { font-size: 12px; color: var(--color-muted); margin-top: 25px; }
  @media (max-width: 700px) {
    h1 { font-size: 28px; }
    .research-english { font-size: 14px; }
    .research-tabs > div { gap: 0; justify-content: space-between; }
    .research-tabs a { font-size: 12px; }
    .download-row { gap: 12px; flex-wrap: wrap; }
    .download-row .button { margin-left: 39px; }
    .download-row > div { flex-basis: calc(100% - 45px); }
  }
</style>
