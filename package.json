  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@lucide/astro": "1.44.0",
    "@types/papaparse": "5.5.2",
    "astro": "7.3.2",
    "papaparse": "5.7.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
